#!/usr/bin/make -f
# Prebuilt-binary packaging for the Drop desktop client.
#
# The Tauri client is compiled in CI and shipped inside the source tarball, so
# this package never configures, builds, tests, or strips anything. `dh_install`
# places the prebuilt files using debian/<package>.install (generated from
# install.in by scripts/distro/prepare-ppa-source.sh).

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_configure:
	:

override_dh_auto_build:
	:

override_dh_auto_test:
	:

override_dh_auto_install:
	:

override_dh_strip:
	:

override_dh_dwz:
	:

# Runtime dependencies are declared explicitly in debian/control; the prebuilt
# binary links against libs that are not installed on the Launchpad builder.
override_dh_shlibdeps:
	:
