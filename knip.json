{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["lefthook.yml"],
      "ignoreDependencies": [
        "lefthook",
        "knip",
        "@ast-grep/cli",
        "prettier",
        "prettier-plugin-sort-json"
      ]
    },
    "desktop": {
      "entry": ["build.mjs"],
      "ignore": ["main/**"]
    },
    "libraries/base": {},
    "server": {
      "entry": [
        "app.vue",
        "error.vue",
        "nuxt.config.ts",
        "plugins/**/*.{ts,js}",
        "middleware/**/*.{ts,js}",
        "layouts/**/*.vue",
        "composables/**/*.{ts,js}",
        "utils/**/*.{ts,js}",
        "**/__tests__/**/*.{ts,js}",
        "dev-tools/**/*.{ts,js,mjs}",
        "i18n/**/*.{ts,js}",
        "rules/**/*.{ts,mts}",
        "deploy-template/**/*.mjs"
      ],
      "ignore": [".nuxt/**", ".output/**", ".data/**", "build/**"],
      "ignoreDependencies": ["vue-i18n"],
      "project": ["**/*.{ts,js,mjs,vue}"]
    },
    "sites/docs": {},
    "sites/promo": {
      "entry": ["content-collections.ts"],
      "ignoreDependencies": ["content-collections"]
    }
  }
}
